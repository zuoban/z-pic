{
  "name": "Z Pic",
  "slug": "z-pic",
  "identifier": "app.zpic.desktop",
  "version": "0.1.0",
  "icon": "resources/icon.png",
  "main": ".",
  "out": "dist",
  "resources": [
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "fileAssociations": [
    {
      "ext": ["jpg", "jpeg"],
      "name": "JPEG Image",
      "mimeType": "image/jpeg",
      "role": "Editor"
    },
    {
      "ext": ["png"],
      "name": "PNG Image",
      "mimeType": "image/png",
      "role": "Editor"
    },
    {
      "ext": ["webp"],
      "name": "WebP Image",
      "mimeType": "image/webp",
      "role": "Editor"
    },
    {
      "ext": ["heic", "heif"],
      "name": "HEIC Image",
      "mimeType": "image/heic",
      "role": "Editor"
    }
  ]
}
